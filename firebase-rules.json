{
  "rules": {
    "shops": {
      "$shop": {
        ".read": "auth != null",

        "profile": {
          ".write": "auth != null",
          "name":  { ".validate": "newData.isString() && newData.val().length <= 80" },
          "tag":   { ".validate": "newData.isString() && newData.val().length <= 120" },
          "area":  { ".validate": "newData.isString() && newData.val().length <= 60" },
          "phone": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "wa":    { ".validate": "newData.isString() && newData.val().length <= 30" },
          "addr":  { ".validate": "newData.isString() && newData.val().length <= 400" },
          "color": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "logo":  { ".validate": "newData.isString() && newData.val().length <= 400000" }
        },

        "posters": {
          ".write": "auth != null",
          "$pid": {
            "tpl":   { ".validate": "newData.isString() && newData.val().length <= 24" },
            "ts":    { ".validate": "newData.isNumber()" },
            "thumb": { ".validate": "newData.isString() && newData.val().length <= 500000" }
          }
        },

        "config": {
          ".write": "auth != null",
          "pinHash": { ".validate": "newData.isString() && newData.val().length == 64" }
        },

        "errorLogs": {
          ".write": "auth != null",
          "$e": { ".validate": "newData.hasChild('at')" }
        },

        "flashMessage":  { ".write": false },
        "announcement":  { ".write": false },
        "license":       { ".write": false }
      }
    }
  }
}
